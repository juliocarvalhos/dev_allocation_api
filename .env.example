# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL (POSTGRES_HOST is overridden to "db" inside Docker Compose)
POSTGRES_DB=dev_allocation
POSTGRES_USER=dev_allocation
POSTGRES_PASSWORD=dev_allocation
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
